@page "/rsvp"

@using Microsoft.AspNetCore.Components.Web

<style>
    /* Your existing styles go here */
    @import url('https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@300;400;600&display=swap');

    :root {
        --primary-color: #8A4FFF;
        --secondary-color: #FFB6C1;
        --accent-color: #F4E1D2;
        --text-color: #4A4238;
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background: linear-gradient(135deg, #FFF0F5 0%, #FFE4E1 100%);
        color: var(--text-color);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
        background-image:
            linear-gradient(rgba(255,255,255,0.8), rgba(255,255,255,0.8)),
            url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><g fill="%23FFB6C1" fill-opacity="0.1"><path d="M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7z"/></g></svg>');
    }

    .form-group {
        margin-bottom: 25px;
        position: relative;
    }

    .form-group:has(.meal-selection) {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid rgba(138, 79, 255, 0.2);
    }

    label {
        display: block;
        margin-bottom: 10px;
        font-weight: 600;
        color: var(--primary-color);
        font-family: 'Great Vibes', cursive;
        font-size: 1.2em;
    }

    input[type="radio"],
    input[type="number"],
    input[type="text"],
    textarea {
        width: 100%;
        padding: 12px;
        margin-top: 8px;
        border: 2px solid var(--secondary-color);
        border-radius: 10px;
        transition: all 0.3s ease;
        font-family: 'Montserrat', sans-serif;
    }

    input:focus,
    textarea:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 10px rgba(138, 79, 255, 0.2);
    }

    .btn {
        background-color: var(--primary-color);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .radio-container {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    /* Add any additional styles as needed */
</style>

<h2>Attendance Details</h2>

<EditForm Model="@rsvpModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Will you attend?</label>
        <div class="radio-container">
            <InputRadio @bind="@rsvpModel.Attendance" value="yes" id="attend-yes" />
            <label for="attend-yes">Yes</label>

            <InputRadio @bind="@rsvpModel.Attendance" value="no" id="attend-no" />
            <label for="attend-no">No</label>
        </div>
    </div>

    <div class="form-group">
        <label for="guests">Total number of guests attending</label>
        <InputNumber @bind="@rsvpModel.TotalGuests" id="guests" min="0" max="10" />
       
        <label for="overnightGuests">Total number of guests staying overnight</label>
        <InputNumber @bind="@rsvpModel.OovernightGuests" id="overnightGuests" min="0" max="10" />

        <div class="form-group">
            <label>Meal Selection</label>
            <div class="meal-selection">
                <div class="meal-type">
                    <label for="default-meals">
                        Standard Meals
                        <InputNumber @bind="@rsvpModel.StandardMeals" id="default-meals" min="0" max="10" placeholder="Number of standard meals" />
                    </label>
                </div>
                <div class="meal-type">
                    <label for="vegetarian-meals">
                        Vegetarian Meals
                        <InputNumber @bind="@rsvpModel.VegetarianMeals" id="vegetarian-meals" min="0" max="10" placeholder="Number of vegetarian meals" />
                    </label>
                </div>
                <div class="meal-type">
                    <label for="vegan-meals">
                        Vegan Meals
                        <InputNumber @bind="@rsvpModel.VeganMeals" id="vegan-meals" min="0" max="10" placeholder="Number of vegan meals" />
                    </label>
                </div>
            </div>
            <div class="meal-counter">
                <span>Total Meals: <span>@TotalMeals()</span></span>
                <span class="warning" id="meal-warning">@mealWarning</span>
            </div>
        </div>

        <div class="form-group">
            <label for="names">Additional information</label>
            <InputTextArea @bind="@rsvpModel.GuestNames" id="names" rows="3" placeholder="Is there anything else we need to know?" />
        </div>

        <button type="submit" class="btn">Submit</button>
    </div>
</EditForm>

