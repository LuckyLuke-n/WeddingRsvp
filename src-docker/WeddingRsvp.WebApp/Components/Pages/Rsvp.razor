@page "/rsvp"
@page "/rsvp/{id}"

@using WeddingRsvp.Client
@using WeddingRsvp.Abstractions.Models

@inject NavigationManager Navigation

<style>
    :root {
        --primary-color: #F4E1D2;
        --secondary-color: #FFB6C1;
        --accent-color: #4A4238;
        --text-color: white;
    }

    /* Wrapper for the form content */
    .rsvp-container {
        width: 100%;
        max-width: 600px; /* 1. Limits the width so it doesn't span the whole screen */
        margin: 50px auto; /* 2. Centers the container horizontally with spacing on top/bottom */
    
        /*padding: 30px;*/
        /*background: rgba(255, 255, 255, 0.85);*/
        /*border-radius: 15px;*/
        /*box-shadow: 0 4px 15px rgba(0,0,0,0.1);*/
        /*border: 2px solid var(--secondary-color);*/
    }

    body {
        font-family: 'WindSong', sans-serif;
        
        /*!* Background spans the whole screen *!*/
        /*background: linear-gradient(135deg, #FFF0F5 0%, #FFE4E1 100%);*/
        /*background-attachment: fixed;*/
        /*color: #4A4238;*/
        
        /* Ensure it takes full height */
        min-height: 100vh;
        margin: 0;
        
        /* Removed justify-content/align-items because we center the container directly in Rsvp.razor.css */
    }

    /* Ensure inputs take full width of the container, not the screen */
    input[type="text"],
    input[type="number"],
    textarea {
        width: 100%;
        box-sizing: border-box; /* Ensures padding doesn't overflow the width */
        color: var(--text-color)
    }

    .form-group {
        margin-bottom: 25px;
        position: relative;
    }

    .form-group:has(.meal-selection) {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid rgba(138, 79, 255, 0.2);
    }

    label {
        display: block;
        margin-bottom: 10px;
        font-weight: 600;
        color: var(--primary-color);
        font-family: 'WindSong', cursive;
        font-size: 1.2em;
    }

    input[type="radio"],
    input[type="number"],
    input[type="text"],
    textarea {
        width: 100%;
        padding: 12px;
        margin-top: 8px;
        border: 2px solid var(--secondary-color);
        border-radius: 10px;
        transition: all 0.3s ease;
        font-family: 'WindSong', sans-serif;
        background-color: rgba(255, 255, 255, 0.2);
        color: var(--text-color)
    }

    input:focus,
    textarea:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
    }

    .btn {
        background-color: var(--secondary-color);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn:hover {
        background-color: var(--accent-color);
        color: white;

        /* Add a slight lift effect */
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }

    .radio-container {
        display: flex;
        align-items: center;
        gap: 20px;
    }
</style>

<EditForm Model="@_rsvp" OnValidSubmit="HandleValidSubmit" class="rsvp-container">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Will you attend?</label>
        <div class="radio-container">
            <InputRadioGroup @bind-Value="@_rsvp.Response">
                    <InputRadio Value="@ResponseType.Yes" id="attend-yes" />
                    <label for="attend-yes">Yes</label>

                    <InputRadio Value="@ResponseType.No" id="attend-no" />
                    <label for="attend-no">No</label>
                </InputRadioGroup>
        </div>
    </div>

    <div class="form-group">
        <label for="guests">Total number of guests attending</label>
        <InputNumber @bind-Value="@_rsvp.NumberOfGuestsAttending" id="guests" min="0" max="10" />
       
        <label for="overnightGuests">Total number of guests staying overnight</label>
        <InputNumber @bind-Value="@_rsvp.NumberOfGuestsOvernight" id="overnightGuests" min="0" max="10" />

        <div class="form-group">
            <label>Meal Selection</label>
            <div class="meal-selection">
                <div class="meal-type">
                    <label for="default-meals">
                        Standard Meals
                        <InputNumber @bind-Value="@_rsvp.NumberOfNormalMeals" id="default-meals" min="0" max="10" placeholder="Number of standard meals" />
                    </label>
                </div>
                <div class="meal-type">
                    <label for="vegetarian-meals">
                        Vegetarian Meals
                        <InputNumber @bind-Value="@_rsvp.NumberOfVegetarianMeals" id="vegetarian-meals" min="0" max="10" placeholder="Number of vegetarian meals" />
                    </label>
                </div>
                <div class="meal-type">
                    <label for="vegan-meals">
                        Vegan Meals
                        <InputNumber @bind-Value="@_rsvp.NumberOfVeganMeals" id="vegan-meals" min="0" max="10" placeholder="Number of vegan meals" />
                    </label>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label for="names">Additional information</label>
            <InputTextArea @bind-Value="@_rsvp.AdditionalInformation" id="names" rows="3" placeholder="Is there anything else we need to know?" />
        </div>

        <button type="submit" class="btn">Submit</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public string? Id { get; set; }

    private RsvpGuest _rsvp = new();
    
    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Id))
            Navigation.NavigateTo("/");
        
    }

    private void HandleValidSubmit()
    {
        //
    }
}