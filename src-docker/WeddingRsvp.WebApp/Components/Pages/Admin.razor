@page "/admin"
@using WeddingRsvp.Abstractions.Models.Rsvps
@using WeddingRsvp.Client
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="admin-container">
    @if (!_isAuthenticated)
    {
        <div class="login-box">
            <h2 style="color: var(--primary-color)">Admin Login</h2>
            <input type="password" @bind="_passphrase" class="admin-input" placeholder="Enter Passphrase" @onkeyup="HandleKeyUp" />
            <button class="btn" style="margin-top: 20px; width: 100%" @onclick="Login">Login</button>
        </div>
    }
    else
    {
        <h2 style="color: var(--primary-color); font-family: var(--font-family), cursive;">Manage Invitations</h2>
        
        <button class="action-btn btn-add" @onclick="AddRow">Add New Entry</button>

        <div style="overflow-x: auto;">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Salutation</th>
                        <th>Response</th>
                        <th>Partner</th>
                        <th>Overnight</th>
                        <th>Meat</th>
                        <th>Fish</th>
                        <th>Veg</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invite in _invites)
                    {
                        <tr>
                            <td><span style="font-size: 0.7em; opacity: 0.6;">@invite.Id</span></td>
                            @if (_editingId == invite.Id)
                            {
                                <td><input @bind="invite.Name" class="admin-input" /></td>
                                <td><input @bind="invite.Salutation" class="admin-input" /></td>
                                <td>
                                    <select @bind="invite.Response" class="admin-input">
                                        @foreach (var val in Enum.GetValues<ResponseType>())
                                        {
                                            <option value="@val">@val</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select @bind="invite.BringPartner" class="admin-input">
                                        @foreach (var val in Enum.GetValues<ResponseType>())
                                        {
                                            <option value="@val">@val</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="number" @bind="invite.NumberOfGuestsOvernight" class="admin-input" style="width: 50px;" /></td>
                                <td><input type="number" @bind="invite.NumberOfMeatMenus" class="admin-input" style="width: 50px;" /></td>
                                <td><input type="number" @bind="invite.NumberOfFishMenus" class="admin-input" style="width: 50px;" /></td>
                                <td><input type="number" @bind="invite.NumberOfVegetarianMenus" class="admin-input" style="width: 50px;" /></td>
                                <td>
                                    <button class="action-btn btn-save" @onclick="() => Save(invite)">Save</button>
                                    <button class="action-btn" @onclick="() => _editingId = null">Cancel</button>
                                </td>
                            }
                            else
                            {
                                <td>@invite.Name</td>
                                <td>@invite.Salutation</td>
                                <td>@invite.Response</td>
                                <td>@invite.BringPartner</td>
                                <td>@invite.NumberOfGuestsOvernight</td>
                                <td>@invite.NumberOfMeatMenus</td>
                                <td>@invite.NumberOfFishMenus</td>
                                <td>@invite.NumberOfVegetarianMenus</td>
                                <td>
                                    <button class="action-btn btn-edit" @onclick="() => _editingId = invite.Id">Edit</button>
                                    <button class="action-btn btn-delete" @onclick="() => Delete(invite.Id)">Delete</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>