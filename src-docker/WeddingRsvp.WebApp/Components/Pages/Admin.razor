@page "/admin"
@using WeddingRsvp.Abstractions.Models.Rsvps
@rendermode InteractiveServer

<div class="admin-container">
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div
            style="background-color: rgba(244, 67, 54, 0.2); border: 1px solid #f44336; color: white; padding: 15px; border-radius: 10px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <span><strong>Error:</strong> @_errorMessage</span>
            <button style="background: none; border: none; color: white; cursor: pointer; font-size: 20px;"
                    @onclick='() => _errorMessage = ""'>&times;
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div
            style="background-color: rgba(76, 175, 80, 0.2); border: 1px solid #4CAF50; color: white; padding: 15px; border-radius: 10px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <span><strong>Success:</strong> @_successMessage</span>
            <button style="background: none; border: none; color: white; cursor: pointer; font-size: 20px;"
                    @onclick='() => _successMessage = ""'>&times;
            </button>
        </div>
    }

    @if (!_isAuthenticated)
    {
        <div class="login-box">
            <h2 style="color: var(--primary-color)">Admin Login</h2>
            <input type="password" @bind="_passphrase" class="admin-input" placeholder="Enter Passphrase"
                   @onkeyup="HandleKeyUp"/>
            <button class="btn" style="margin-top: 20px; width: 100%" @onclick="LoginAsync">Login</button>
        </div>
    }
    else
    {
        <h2 style="color: var(--primary-color); font-family: var(--font-family), cursive;">Manage Invitations</h2>

        <button class="action-btn btn-add" @onclick="AddRow">Add New Entry</button>

        <div class="section-wrapper">
            <!-- Table here -->
            <div style="overflow-x: auto;">
                <table>
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Salutation</th>
                        <th>As for partner</th>
                        <th>Response</th>
                        <th>Partner</th>
                        <th>Overnight</th>
                        <th>Brunch</th>
                        <th>Meat menu</th>
                        <th>Vegetarian menu</th>
                        <th>Additional info</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var invite in _invites)
                    {
                        <tr>
                            <td><span style="font-size: 0.7em; opacity: 0.6;">@invite.Id</span></td>
                            @if (_editingId == invite.Id)
                            {
                                <td><input @bind="invite.Name" class="admin-input"/></td>
                                <td><input @bind="invite.Salutation" class="admin-input"/></td>
                                <td>
                                    <select class="admin-input" value="@invite.IsPlural.ToString().ToLower()"
                                            @onchange="@(e => invite.IsPlural = bool.Parse(e.Value?.ToString() ?? "false"))">
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </select>
                                </td>
                                <td>
                                    <select @bind="invite.Response" class="admin-input">
                                        @foreach (var val in Enum.GetValues<ResponseType>())
                                        {
                                            <option value="@val">@val</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select @bind="invite.BringPartner" class="admin-input">
                                        @foreach (var val in Enum.GetValues<ResponseType>())
                                        {
                                            <option value="@val">@val</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" @bind="invite.NumberOfGuestsOvernight" class="admin-input"
                                           style="width: 50px;"/></td>
                                <td>
                                    <input type="number" @bind="invite.NumberOfBrunchGuests" class="admin-input"
                                           style="width: 50px;"/></td>
                                <td>
                                    <input type="number" @bind="invite.NumberOfMeatMenus" class="admin-input"
                                           style="width: 50px;"/></td>
                                <td>
                                    <input type="number" @bind="invite.NumberOfVegetarianMenus" class="admin-input"
                                           style="width: 50px;"/></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(invite.AdditionalInformation))
                                    {
                                        <button class="action-btn" 
                                                style="background: var(--info-color); color: white; width: 50px;"
                                                @onclick="() => ToggleInfo(invite.Id)">
                                            Yes
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="opacity: 0.5; padding-left: 12px;">No</span>
                                    }
                                </td>
                                <td>
                                    <button class="action-btn btn-save" @onclick="() => SaveInvite()">Save</button>
                                    <button class="action-btn" @onclick="() => _editingId = null">Cancel</button>
                                </td>
                            }
                            else
                            {
                                <td>@invite.Name</td>
                                <td>@invite.Salutation</td>
                                <td>@invite.IsPlural</td>
                                <td>@invite.Response</td>
                                <td>@invite.BringPartner</td>
                                <td>@invite.NumberOfGuestsOvernight</td>
                                <td>@invite.NumberOfBrunchGuests</td>
                                <td>@invite.NumberOfMeatMenus</td>
                                <td>@invite.NumberOfVegetarianMenus</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(invite.AdditionalInformation))
                                    {
                                        <button class="action-btn" 
                                                style="background: var(--info-color); color: white; width: 50px;"
                                                @onclick="() => ToggleInfo(invite.Id)">
                                            Yes
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="opacity: 0.5; padding-left: 12px;">No</span>
                                    }
                                </td>
                                <td>
                                    <button class="action-btn btn-edit" @onclick="() => _editingId = invite.Id">Edit
                                    </button>
                                    <button class="action-btn btn-delete" @onclick="() => DeleteAsync(invite.Id)">Delete
                                    </button>
                                </td>
                            }
                        </tr>
                        @if (string.Equals(_expandedId, invite.Id)&& !string.IsNullOrWhiteSpace(invite.AdditionalInformation))
                        {
                            <tr>
                                <td colspan="12" style="background: rgba(255, 255, 255, 0.05); padding: 15px; border-left: 4px solid var(--secondary-color);">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                        <div>
                                            <strong style="color: var(--secondary-color); display: block; margin-bottom: 5px;">Guest Comments:</strong>
                                            <p style="margin: 0; font-style: italic; white-space: pre-wrap;">@invite.AdditionalInformation</p>
                                        </div>
                                        <button class="action-btn" style="background: rgba(255,255,255,0.1); color: white;" @onclick="() => _expandedId = null">Close</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <hr style="border: 1px solid rgba(255,255,255,0.1); margin: 40px 0;"/>

        <div class="section-wrapper">
            <!-- Dynamic Info here -->

            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
                <h2 style="color: var(--primary-color); font-family: var(--font-family), cursive; margin: 0;">Dynamic
                    Content</h2>

                <div style="display: flex; align-items: center; gap: 10px;">
                    <label style="color: var(--secondary-color);">Select Language:</label>
                    <select class="admin-input"
                            style="width: auto; min-width: 150px; background-color: #333; color: white;"
                            @onchange="@(e => ChangeLanguage(e.Value?.ToString() ?? "de"))">
                        <option value="de" selected="@(_selectedLanguage == "de")"
                                style="background-color: #333; color: white;">German (DE)
                        </option>
                        <option value="en" selected="@(_selectedLanguage == "en")"
                                style="background-color: #333; color: white;">English (EN)
                        </option>
                    </select>
                </div>
            </div>

            <div class="info-section">
                <label>Invitation Text</label>
                <textarea @bind="_information.InvitationText" class="admin-input" rows="4"
                          style="margin-top: 10px;"></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                <!-- Itinerary Section -->
                <div>
                    <h3 style="color: var(--secondary-color)">Itinerary</h3>
                    <table>
                        <thead>
                        <tr>
                            <th>Time/Event</th>
                            <th>Description</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in _information.Itinerary)
                        {
                            <tr>
                                <td>
                                    <input value="@item.Key"
                                           @onchange="@(e => UpdateDictionaryKey(_information.Itinerary, item.Key, e.Value?.ToString()))"
                                           class="admin-input"/></td>
                                <td><input @bind="_information.Itinerary[item.Key]" class="admin-input"/></td>
                                <td>
                                    <button class="action-btn btn-delete"
                                            @onclick="() => _information.Itinerary.Remove(item.Key)">×
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <button class="action-btn btn-add" style="margin-top: 10px;"
                            @onclick='() => AddDictionaryEntry(_information.Itinerary, "New Event", "Description")'>+
                        Add Event
                    </button>
                </div>

                <!-- FAQ Section -->
                <div>
                    <h3 style="color: var(--secondary-color)">FAQs</h3>
                    <table>
                        <thead>
                        <tr>
                            <th>Question</th>
                            <th>Answer</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in _information.Faqs)
                        {
                            <tr>
                                <td>
                                    <input value="@item.Key"
                                           @onchange="@(e => UpdateDictionaryKey(_information.Faqs, item.Key, e.Value?.ToString()))"
                                           class="admin-input"/></td>
                                <td><input @bind="_information.Faqs[item.Key]" class="admin-input"/></td>
                                <td>
                                    <button class="action-btn btn-delete"
                                            @onclick="() => _information.Faqs.Remove(item.Key)">×
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <button class="action-btn btn-add" style="margin-top: 10px;"
                            @onclick='() => AddDictionaryEntry(_information.Faqs, "New Question", "New Answer")'>+ Add
                        FAQ
                    </button>
                </div>
            </div>

            <div style="margin-top: 30px; text-align: right;">
                <button class="btn btn-save" style="padding: 10px 30px;" @onclick="SaveInformationAsync">Save
                    information
                </button>
            </div>
        </div>
    }
</div>