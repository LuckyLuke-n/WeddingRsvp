@inherits LayoutComponentBase

<div class="page-background-class">
    
    <div class="page w-100">
        <main>
            <article class="content px-4 d-flex justify-content-center">
                @Body
            </article>
        </main>
    </div>

    <div id="blazor-error-ui" data-nosnippet>
